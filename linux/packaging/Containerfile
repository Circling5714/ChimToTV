# Môi trường dựng bản phát hành Linux: Ubuntu 22.04 (glibc 2.35, GTK 3.24.33, WebKitGTK 4.1) — tệp chạy dựng ở đây chạy được
# trên Ubuntu 22.04+ / Linux Mint 21+ / Debian 12+. Dựng ảnh: podman build -t conbangtv-build -f packaging/Containerfile packaging
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -q && apt-get install -y -q --no-install-recommends \
      build-essential curl ca-certificates pkg-config git file \
      libgtk-3-dev libwebkit2gtk-4.1-dev libssl-dev dpkg-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y -q --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /src/linux
