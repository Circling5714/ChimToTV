<Window x:Class="ConBangTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Côn Bằng TV" Width="1360" Height="820" MinWidth="720" MinHeight="480"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="15"
        Icon="app.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
  <Grid x:Name="Root">
    <!-- Phần giao diện (phóng theo «Cỡ giao diện» trong Cài đặt) -->
    <Grid x:Name="Shell">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Menu bên trái -->
      <Border Background="{StaticResource Surface}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="20,22,16,14">
            <StackPanel Orientation="Horizontal">
              <Image Source="logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Côn Bằng TV" FontSize="19" FontWeight="Bold" />
                <TextBlock x:Name="SiteName" FontSize="13" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,4,0,12">
            <StackPanel x:Name="MenuPanel" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Nội dung -->
      <Grid Grid.Column="1" x:Name="ContentArea">
        <ContentControl x:Name="PageHost" Focusable="False" />
        <StackPanel x:Name="LoadingBox" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <ProgressBar IsIndeterminate="True" Width="260" />
          <TextBlock x:Name="LoadingText" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Trình phát (không phóng theo cỡ giao diện) -->
    <ContentControl x:Name="PlayerHost" Focusable="False" Visibility="Collapsed" />

    <!-- Hộp thoại trong app (đi được bằng remote) -->
    <Grid x:Name="DialogLayer" Background="#B3000000" Visibility="Collapsed">
      <Border x:Name="DialogBox" Background="{StaticResource Surface}" CornerRadius="14" Padding="28,24" MaxWidth="620" MinWidth="380"
              HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Surface3}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="DialogText" FontSize="15" Margin="0,12,0,0" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
          <ContentControl x:Name="DialogExtra" Focusable="False" Margin="0,12,0,0" />
          <WrapPanel x:Name="DialogButtons" Margin="0,20,0,0" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Thông báo ngắn -->
    <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,36" Padding="20,12"
            CornerRadius="10" Background="#F0232833" BorderBrush="{StaticResource Surface3}" BorderThickness="1"
            Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="760">
      <TextBlock x:Name="ToastText" FontSize="15" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
