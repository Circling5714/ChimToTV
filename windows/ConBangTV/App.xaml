<Application x:Class="ConBangTV.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Màu giống bản TV (res/values/colors.xml) -->
    <Color x:Key="BgColor">#0E1014</Color>
    <SolidColorBrush x:Key="Bg" Color="#0E1014" />
    <SolidColorBrush x:Key="Surface" Color="#171A21" />
    <SolidColorBrush x:Key="Surface2" Color="#232833" />
    <SolidColorBrush x:Key="Surface3" Color="#2E3442" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="TextDim" Color="#9AA3B2" />
    <SolidColorBrush x:Key="Focus" Color="#FFB020" />
    <SolidColorBrush x:Key="OnFocus" Color="#14110A" />
    <SolidColorBrush x:Key="Brand" Color="#2BAF85" />
    <SolidColorBrush x:Key="Watched" Color="#3A6B5C" />
    <SolidColorBrush x:Key="Scrim" Color="#CC000000" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Nút chung: bo tròn, sáng màu cam khi đang chọn bằng phím / remote -->
    <Style x:Key="Pill" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Brand}" />
              </Trigger>
              <Trigger Property="Tag" Value="watched">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Watched}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#55FFFFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Focus}" />
                <Setter Property="Foreground" Value="{StaticResource OnFocus}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Pill}" />

    <!-- Mục menu bên trái -->
    <Style x:Key="MenuItem" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="8,1" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <DockPanel>
                <Border x:Name="Bar" DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="-8,2,10,2" Background="Transparent" />
                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False" />
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brand}" />
                <Setter TargetName="B" Property="Background" Value="{StaticResource Surface2}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Surface2}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource Focus}" />
                <Setter Property="Foreground" Value="{StaticResource OnFocus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thẻ phim: ảnh bìa 2:3, nhãn tập, tên phim 2 dòng; đang chọn thì viền cam và phóng nhẹ -->
    <Style x:Key="Card" TargetType="Button">
      <Setter Property="Width" Value="168" />
      <Setter Property="Margin" Value="0,0,18,22" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <StackPanel Background="Transparent">
              <Border x:Name="Frame" Height="248" CornerRadius="10" BorderThickness="3" BorderBrush="Transparent"
                      Background="{StaticResource Surface2}">
                <Grid>
                  <Grid.Clip>
                    <RectangleGeometry x:Name="ClipRect" RadiusX="8" RadiusY="8" Rect="0,0,162,242" />
                  </Grid.Clip>
                  <TextBlock Text="鵬" FontSize="54" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="Poster" Stretch="UniformToFill" />
                  <Border x:Name="BadgeBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="7,3" CornerRadius="6"
                          Background="#E6000000">
                    <TextBlock x:Name="Badge" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                  </Border>
                  <Border x:Name="NewBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="7,3" CornerRadius="6"
                          Background="#E5533D" Visibility="Collapsed">
                    <TextBlock x:Name="NewText" FontSize="12.5" FontWeight="Bold" Foreground="White" />
                  </Border>
                  <!-- Điểm IMDb (dữ liệu KKPhim) — vàng như logo IMDb -->
                  <Border x:Name="ImdbBox" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,6,6,10" Padding="5,1" CornerRadius="4"
                          Background="#F5C518" Visibility="Collapsed">
                    <TextBlock x:Name="ImdbText" FontSize="12" FontWeight="Bold" Foreground="Black" />
                  </Border>
                  <Border x:Name="ProgressBack" VerticalAlignment="Bottom" Height="5" Background="#66000000" Visibility="Collapsed">
                    <Border x:Name="ProgressBar" HorizontalAlignment="Left" Background="{StaticResource Brand}" />
                  </Border>
                </Grid>
              </Border>
              <TextBlock x:Name="Title" Margin="2,7,2,0" FontSize="14.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
              <TextBlock x:Name="Sub" Margin="2,1,2,0" FontSize="12.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"
                         Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#66FFFFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Focus}" />
                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Focus}" />
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                  </Setter.Value>
                </Setter>
                <Setter Property="Panel.ZIndex" Value="5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Brand}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource Surface3}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PassBox" TargetType="PasswordBox">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource Surface3}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Focus}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thanh cuộn mảnh, tối -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#55FFFFFF" CornerRadius="4" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
              <Track.Thumb>
                <Thumb Style="{StaticResource ThumbStyle}" />
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="10" />
          <Setter Property="MinHeight" Value="10" />
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ThumbStyle}" />
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Thanh tua trong trình phát -->
    <Style x:Key="SeekSlider" TargetType="Slider">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="22" Background="Transparent">
              <Border Height="5" CornerRadius="2.5" Background="#55FFFFFF" VerticalAlignment="Center" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="5" CornerRadius="2.5" Background="{StaticResource Brand}" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource Brand}" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="4" />
    </Style>
  </Application.Resources>
</Application>
