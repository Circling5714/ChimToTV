<?xml version="1.0" encoding="utf-8"?>
<!-- Miễn trừ trách nhiệm (DisclaimerActivity): tiêu đề, vùng chữ cuộn được bằng remote, nút Đồng ý / Thoát (hoặc Đóng) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/disclaimerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/disclaimerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/disclaimerSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_dim"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/disclaimerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:focusable="true"
        android:padding="16dp"
        android:scrollbarFadeDuration="0"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/disclaimerBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAgree"
            style="@style/TvButton"
            android:minWidth="140dp" />

        <TextView
            android:id="@+id/btnExit"
            style="@style/TvButton"
            android:minWidth="120dp"
            android:text="Thoát" />

        <TextView
            android:id="@+id/disclaimerHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
