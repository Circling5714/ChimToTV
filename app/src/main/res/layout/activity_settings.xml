<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cài đặt"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Địa chỉ trang phim" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/url_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textUri"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nhập tên miền rồi nhấn Lưu để thêm trang mới hoặc cập nhật khi trang đổi tên miền (vd .ee → .xyz). Hỗ trợ các trang kiểu yanhh3d, theme HaLim (hoathinh3d, hhkungfu…) và kiểu PhimMoi (phimmoir). Nếu tên miền cũ tự chuyển hướng, app tự cập nhật."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSave"
                style="@style/TvButton"
                android:text="Lưu" />

            <TextView
                android:id="@+id/btnTest"
                style="@style/TvButton"
                android:text="Kiểm tra kết nối" />

            <TextView
                android:id="@+id/btnDefault"
                style="@style/TvButton"
                android:text="Về mặc định" />

            <TextView
                android:id="@+id/btnRemove"
                style="@style/TvButton"
                android:text="Xoá khỏi danh sách" />
        </LinearLayout>

        <TextView
            android:id="@+id/testResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Danh sách trang phim (chọn để chuyển trang)" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            style="@style/SettingsLabel"
            android:text="Proxy SOCKS5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnProxy"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnProxyDns"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnProxyScope"
                style="@style/TvButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/proxyHost"
                style="@style/ProxyInput"
                android:layout_weight="3"
                android:hint="Máy chủ proxy (vd 103.1.2.3 hoặc dán socks5://user:pass@host:cổng)"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/proxyPort"
                style="@style/ProxyInput"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="Cổng (vd 1080)"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/proxyUser"
                style="@style/ProxyInput"
                android:layout_weight="1"
                android:hint="Tên đăng nhập (bỏ trống nếu không có)"
                android:inputType="text" />

            <EditText
                android:id="@+id/proxyPass"
                style="@style/ProxyInput"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="Mật khẩu (bỏ trống nếu không có)"
                android:inputType="textPassword" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnProxySave"
                style="@style/TvButton"
                android:text="Lưu proxy" />

            <TextView
                android:id="@+id/btnProxyTest"
                style="@style/TvButton"
                android:text="Kiểm tra proxy" />
        </LinearLayout>

        <TextView
            android:id="@+id/proxyResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Phát video" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSeek"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnAutoNext"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnServer"
                style="@style/TvButton" />
        </LinearLayout>

        <TextView
            style="@style/SettingsLabel"
            android:text="Dữ liệu" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnClearHistory"
                style="@style/TvButton"
                android:text="Xoá lịch sử xem" />

            <TextView
                android:id="@+id/btnClearCache"
                style="@style/TvButton"
                android:text="Xoá ảnh &amp; dữ liệu duyệt web" />
        </LinearLayout>

        <TextView
            style="@style/SettingsLabel"
            android:text="Cập nhật app" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUpdateCheck"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnAutoUpdate"
                style="@style/TvButton" />
        </LinearLayout>

        <TextView
            android:id="@+id/updateResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="App tự tìm bản mới trên GitHub khi mở (tối đa 2 giờ một lần), tải sẵn rồi hỏi cài. Android luôn yêu cầu bấm xác nhận cài."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Liên hệ" />

        <!-- Nút (không phải chữ thường) để remote đi tới được và màn hình cuộn xuống tới mục này -->
        <TextView
            android:id="@+id/btnContact"
            style="@style/TvButton"
            android:layout_marginTop="8dp"
            android:text="Telegram: t.me/tivikit" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Góp ý, báo lỗi, hỏi đáp: nhắn nhóm Telegram @tivikit (trên điện thoại mở t.me/tivikit)."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
