<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settingsBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cài đặt"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Người xem (chọn một người để chuyển sang, đổi tên / màu, mã PIN, xoá)" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/profileRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnProfileAdd"
                style="@style/TvButton"
                android:text="＋ Thêm người xem" />

            <TextView
                android:id="@+id/btnAskProfile"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnLimits"
                style="@style/TvButton"
                android:text="Giới hạn giờ xem…" />

            <TextView
                android:id="@+id/btnSync"
                style="@style/TvButton"
                android:text="Đồng bộ với iPad / iPhone…" />
        </vn.chimto.tv.FlowRow>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mỗi người có riêng: lịch sử xem, hàng Xem tiếp, chỗ đang xem dở, phim theo dõi, trang phim đang dùng, server ưu tiên, Xem riêng, bước tua, tự chuyển tập, khung hình. Dùng chung cả nhà: danh sách trang phim, proxy, DNS mã hoá, dữ liệu duyệt web, điểm server, mốc nhạc mở đầu. Người có mã PIN phải nhập mã mới mở / sửa được. Giới hạn giờ xem: số phút mỗi ngày và giờ đi ngủ cho từng người (vd trẻ em), cần mã PIN phụ huynh; người lớn nên đặt mã PIN cho hồ sơ của mình để trẻ không chuyển sang được."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Trang chủ" />

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnHomeMix"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnKids"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnHomeRows"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnHomeSources"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnFeedRetry"
                style="@style/TvButton"
                android:visibility="gone" />
        </vn.chimto.tv.FlowRow>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tổng hợp: trang chủ lấy phim mới từ mọi trang trong danh sách (KKPhim, NguonC, VSMOV, CLB Phim Xưa và trang đang dùng), gộp phim trùng giữa các trang («3 nguồn» — trang phim có nút đổi nguồn), xếp hàng theo lịch sử xem của từng người: phim đang xem dở có tập mới ở bất kỳ trang nào, phim giống phim vừa xem, thể loại hay xem. Trang nào lỗi / quá 6 giây thì dùng bản lưu; lỗi 3 lần liên tiếp thì tạm nghỉ 30 phút. Theo trang đang dùng: trang chủ của một trang như trước. Riêng từng người xem. Hồ sơ trẻ em: trang chủ (luôn kiểu tổng hợp) chỉ có phim hoạt hình hợp trẻ em — thiếu nhi, gia đình, lồng tiếng, bỏ phim kinh dị / hình sự / chiến tranh / 18+; chỉ lọc trang chủ, tìm kiếm và mục của trang vẫn như cũ. Tắt cần mã PIN phụ huynh (nếu đã đặt trong Giới hạn giờ xem). Các hàng: bật / tắt, đổi thứ tự, thêm hàng của mình — trên trang chủ nhấn Menu (hoặc giữ OK) trên một phim của hàng để ẩn / chuyển nhanh hàng đó. Nguồn: chọn trang chủ lấy phim từ những nguồn nào."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Địa chỉ trang phim" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/url_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textUri"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nhập tên miền rồi nhấn Lưu để thêm trang mới hoặc cập nhật khi trang đổi tên miền (vd .ee → .xyz). Hỗ trợ các trang kiểu yanhh3d, theme HaLim (hoathinh3d, hhkungfu…), kiểu PhimMoi (phimmois), mephim.ddns.net, KKPhim (kkphim.com), NguonC (phim.nguonc.com), VSMOV (vsmov.com) và CLB Phim Xưa (sc.k-20.xyz). Nếu tên miền cũ tự chuyển hướng, app tự cập nhật."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnSave"
                style="@style/TvButton"
                android:text="Lưu" />

            <TextView
                android:id="@+id/btnTest"
                style="@style/TvButton"
                android:text="Kiểm tra kết nối" />

            <TextView
                android:id="@+id/btnDefault"
                style="@style/TvButton"
                android:text="Về mặc định" />

            <TextView
                android:id="@+id/btnRemove"
                style="@style/TvButton"
                android:text="Xoá khỏi danh sách" />
        </vn.chimto.tv.FlowRow>

        <TextView
            android:id="@+id/testResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Danh sách trang phim (chọn để chuyển trang)" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            style="@style/SettingsLabel"
            android:text="Proxy (SOCKS5 / Shadowsocks)" />

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnProxy"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnProxyKind"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnProxyDns"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnProxyScope"
                style="@style/TvButton" />
        </vn.chimto.tv.FlowRow>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:id="@+id/proxyRow1">

            <EditText
                android:id="@+id/proxyHost"
                style="@style/ProxyInput"
                android:layout_weight="3"
                android:hint="Máy chủ proxy (vd 103.1.2.3 hoặc dán socks5://user:pass@host:cổng)"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/proxyPort"
                style="@style/ProxyInput"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="Cổng (vd 1080)"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:id="@+id/proxyRow2">

            <EditText
                android:id="@+id/proxyUser"
                style="@style/ProxyInput"
                android:layout_weight="1"
                android:hint="Tên đăng nhập (bỏ trống nếu không có)"
                android:inputType="text" />

            <EditText
                android:id="@+id/proxyPass"
                style="@style/ProxyInput"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="Mật khẩu (bỏ trống nếu không có)"
                android:inputType="textPassword" />
        </LinearLayout>

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnProxySave"
                style="@style/TvButton"
                android:text="Lưu proxy" />

            <TextView
                android:id="@+id/btnProxyTest"
                style="@style/TvButton"
                android:text="Kiểm tra proxy" />
        </vn.chimto.tv.FlowRow>

        <TextView
            android:id="@+id/proxyResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="DNS mã hoá (DoH / DoT)" />

        <TextView
            android:id="@+id/btnDoh"
            style="@style/TvButton"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hỏi địa chỉ trang qua DNS mã hoá thay cho DNS nhà mạng: DoH rồi DoT, lần lượt NextDNS → Cloudflare → Google; lỗi hết thì dùng DNS của máy — app không hỏng khi DNS mã hoá bị chặn. Nhà mạng không đọc / sửa được truy vấn DNS (vẫn thấy tên trang lúc kết nối — Vượt chặn lo phần này). Đang bật proxy với «DNS của proxy» thì proxy tự hỏi DNS."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Vượt chặn nhà mạng" />

        <TextView
            android:id="@+id/btnUnblock"
            style="@style/TvButton"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Một số nhà mạng chặn trang phim bằng cách đọc tên trang trong gói bắt tay HTTPS: trang mở mãi không được, dùng VPN thì vào được. Bật mục này: app chia nhỏ gói đó nên nhà mạng không đọc được tên trang — không cần VPN hay proxy. Trang / ảnh bìa bị chặn bằng DNS (DNS trả 0.0.0.0) thì app tự hỏi lại địa chỉ qua DNS mã hoá. Dùng được cùng DNS mã hoá và proxy."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Phát video" />

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnSeek"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnAutoNext"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnServer"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnKkBackup"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnNcBackup"
                style="@style/TvButton" />
        </vn.chimto.tv.FlowRow>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Server dự phòng KKPhim / NguonC: với yanhh3d, hoathinh3d, hhkungfu… (trình phát của trang hay hỏng cùng lúc) app tìm cùng phim, cùng tập trên KKPhim và NguonC rồi thêm server «KKPhim Vietsub / Thuyết Minh», «NguonC Vietsub…» vào menu ▼ lúc xem (NguonC hay có tập mới sớm, nhưng trình phát của nó chạy quảng cáo trước phim — app tự bỏ qua). Trang không vào được mà nguồn dự phòng có tập đó thì vẫn xem được."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <!-- Hình trong hình (ẩn trên TV không có tính năng này) -->
        <TextView
            android:id="@+id/btnPipHome"
            style="@style/TvButton"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pipHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hình trong hình: lúc xem nhấn ▼ → «Thu nhỏ vào góc» (hoặc bấm Home nếu bật ở trên) — phim chạy tiếp ở góc màn hình, vẫn chọn phim khác / dùng app khác được. Đầu menu bên trái có «Phóng to» và «Tắt phim thu nhỏ»."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Dữ liệu" />

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnClearHistory"
                style="@style/TvButton"
                android:text="Xoá lịch sử xem" />

            <TextView
                android:id="@+id/btnClearCache"
                style="@style/TvButton"
                android:text="Xoá ảnh &amp; dữ liệu duyệt web" />
        </vn.chimto.tv.FlowRow>

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnPrivate"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnAutoClear"
                style="@style/TvButton" />
        </vn.chimto.tv.FlowRow>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xem riêng: không ghi phim đã xem và chỗ đang xem (tắt app là quên). Tự xoá: xoá cookie, dữ liệu trang và bộ nhớ đệm mỗi khi rời app. Trong Lịch sử xem / hàng Xem tiếp: giữ OK (hoặc nhấn Menu) trên một phim để xoá riêng phim đó."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Cập nhật app" />

        <vn.chimto.tv.FlowRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnUpdateCheck"
                style="@style/TvButton" />

            <TextView
                android:id="@+id/btnAutoUpdate"
                style="@style/TvButton" />
        </vn.chimto.tv.FlowRow>

        <TextView
            android:id="@+id/updateResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="App tự tìm bản mới trên GitHub khi mở (tối đa 2 giờ một lần), tải sẵn rồi hỏi cài. Android luôn yêu cầu bấm xác nhận cài."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="Liên hệ" />

        <!-- Mã Downloader + mã QR để người quen cài app lên tivi của họ (InviteActivity); chữ đặt trong SettingsActivity -->
        <TextView
            android:id="@+id/btnInvite"
            style="@style/TvButton"
            android:layout_marginTop="8dp" />

        <!-- Nút (không phải chữ thường) để remote đi tới được và màn hình cuộn xuống tới mục này -->
        <TextView
            android:id="@+id/btnContact"
            style="@style/TvButton"
            android:layout_marginTop="8dp"
            android:text="Telegram: t.me/tivikit" />

        <TextView
            android:id="@+id/btnDisclaimer"
            style="@style/TvButton"
            android:layout_marginTop="8dp"
            android:text="Miễn trừ trách nhiệm &amp; quyền riêng tư" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Góp ý, báo lỗi, hỏi đáp: nhắn nhóm Telegram @tivikit (trên điện thoại mở t.me/tivikit)."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
