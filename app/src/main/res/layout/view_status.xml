<?xml version="1.0" encoding="utf-8"?>
<!-- Trạng thái đang tải / lỗi, đặt chồng lên vùng nội dung -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/statusProgress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/focus" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:maxWidth="560dp"
        android:textColor="@color/text_dim"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/statusRetry"
        style="@style/TvButton"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="0dp"
        android:text="@string/retry"
        android:visibility="gone" />
</LinearLayout>
