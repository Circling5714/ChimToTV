<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_backdrop_scrim" />

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="24dp"
        android:paddingEnd="36dp">

        <LinearLayout
            android:id="@+id/headRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/poster"
                android:layout_width="124dp"
                android:layout_height="186dp"
                android:background="@color/surface2"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/infoCol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />

                <!-- Cuộn ngang khi nhiều nút không vừa màn hình; điện thoại cầm dọc: chuyển xuống dưới poster, rộng cả màn -->
                <HorizontalScrollView
                    android:id="@+id/btnScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPlay"
                        style="@style/TvButton"
                        android:nextFocusUp="@id/btnPlay"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnLatest"
                        style="@style/TvButton"
                        android:nextFocusUp="@id/btnLatest"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnFirst"
                        style="@style/TvButton"
                        android:nextFocusUp="@id/btnFirst"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnOrder"
                        style="@style/TvButton"
                        android:nextFocusUp="@id/btnOrder"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnFollow"
                        style="@style/TvButton"
                        android:nextFocusUp="@id/btnFollow"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnJump"
                        style="@style/TvButton"
                        android:nextFocusUp="@id/btnJump"
                        android:text="Đến tập…"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnWeb"
                        style="@style/TvButton"
                        android:nextFocusUp="@id/btnWeb"
                        android:text="Mở Web" />
                </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/epLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:textColor="@color/focus"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Bản phim: Việt Sub / Thuyết Minh… (trang chia tập theo server) -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/groupRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />

            <include
                android:id="@+id/status"
                layout="@layout/view_status" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
