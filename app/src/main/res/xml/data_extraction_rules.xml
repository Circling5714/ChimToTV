<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: không sao lưu lên đám mây, không chuyển sang máy mới (lịch sử xem, mật khẩu proxy, cookie). Android
     11 trở xuống: allowBackup="false" trong manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
